PORT=5000

# Cloudinary (user passport photo uploads, see in src/utility/cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Why can't we use cloudinary url?
#Respond as comment or discussion 

Sample - CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@j7kmi9w6
# Email (nodemailer, see src/utility/mail) — sent to applicants after they submit
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Frontend base URL used to build the create-password link in the email
FRONTEND_URL=http://localhost:3000

# Secret used to sign login JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=

# Bachs payments (see src/utility/bachs). Applicants pay the program fee before they get a GS code.
# sk_sandbox_ keys use https://sandbox-api.bachs.io, sk_live_ keys https://api.bachs.io
BACHS_API_KEY=
# Price: either a Bachs product id, or a fixed amount + currency
BACHS_PRODUCT_ID=
BACHS_AMOUNT=
BACHS_CURRENCY=
# Bachs rejects localhost redirect URLs. While running locally, set these to any public URL
# (a deployed frontend or a tunnel); otherwise they default to FRONTEND_URL.
BACHS_SUCCESS_URL=
BACHS_CANCEL_URL=
